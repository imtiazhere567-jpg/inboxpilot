# Ops Agent — environment variables
# Copy to .env for local dev. On Railway, set each of these as a service variable. NEVER commit .env.
# "Needed from" = the phase in which the value must exist. Blank = not needed yet.

# ---------------------------------------------------------------- app (Phase 0)
APP_ENV=dev                          # dev | prod | test
APP_BASE_URL=http://localhost:8000
DEMO_PASSWORD=                       # shared demo login (Phase 7). Empty = no login gate (dev only)
RESET_TOKEN=change-me                # bearer token for POST /reset and POST /inject
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true

# ---------------------------------------------------------------- database (Phase 0)
# Local: your installed PostgreSQL. scripts/init_db.py creates the database named at the end of the URL.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_LOCAL_PG_PASSWORD@localhost:5432/ops_agent

# ---------------------------------------------------------------- Claude (Phase 2)
# Console API key (platform.claude.com -> API keys). Pay-as-you-go; a claude.ai subscription cannot be used here.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=claude-sonnet-5
CLAUDE_MODEL_VERIFY=claude-haiku-4-5-20251001
LLM_FAKE=false                       # true = deterministic fake LLM (tests / no key)

# ---------------------------------------------------------------- Gmail demo account (Phase 3)
# A dedicated Gmail account, 2-Step Verification ON, then Google Account -> Security -> App passwords.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_LABEL_INBOX=ops-agent/inbox
GMAIL_LABEL_PROCESSED=ops-agent/processed

# ---------------------------------------------------------------- Rules sheet (Phase 2 — fallback to DB table if empty)
# Google Cloud: create a service account, download its JSON key, share the Sheet with the service-account email (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
RULES_SHEET_ID=                      # the long id in the Sheet URL
RULES_SHEET_TAB=rules
RULES_CACHE_SECONDS=60

# ---------------------------------------------------------------- HubSpot developer test account (Phase 3)
# developers.hubspot.com -> create test account -> Settings -> Integrations -> Private apps -> token
# Scopes: crm.objects.companies.read/write, tickets (crm.objects.tickets.read/write), crm.objects.contacts.read
HUBSPOT_ACCESS_TOKEN=

# ---------------------------------------------------------------- QuickBooks Online sandbox (Phase 3)
# developer.intuit.com -> create app -> Keys & credentials (Development) -> OAuth playground for refresh token + realm id
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox

# ---------------------------------------------------------------- Slack (Phase 3)
# api.slack.com/apps -> new app -> Bot token scopes: chat:write, chat:write.public -> install -> xoxb- token
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#ops-agent

# ---------------------------------------------------------------- scheduler (Phase 3/5)
INTAKE_POLL_SECONDS=30
RESET_INTERVAL_MINUTES=60
RESET_IDLE_MINUTES=15
